<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeArguments>--stack-size 8388608</RuntimeArguments> <!-- 8MB stack size -->    
  </PropertyGroup>

  <ItemGroup>
    <!-- FsLexYacc runtime via NuGet -->    
    <PackageReference Include="FsLexYacc" Version="11.3.0" PrivateAssets="all" />
    <PackageReference Include="FsLexYacc.Runtime" Version="11.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Util.fs" />
    <Compile Include="CmdLine.fs" />        
    <Compile Include="Absyn.fs" />
    <Compile Include="FunPar.fs" />
    <Compile Include="FunLex.fs" />
    <Compile Include="TypeInference.fs" />
    <Compile Include="HigherFun.fs" />
    <Compile Include="Machine.fs" />
    <Compile Include="Contcomp.fs" />
    <Compile Include="Parse.fs" />
    <Compile Include="MicroSMLC.fs" />    
  </ItemGroup>

  <ItemGroup>
    <!-- Source generators -->
    <FsYacc Include="FunPar.fsy">
      <OtherFlags>--module FunPar</OtherFlags>
    </FsYacc>

    <FsLex Include="FunLex.fsl">
      <OtherFlags>--unicode</OtherFlags>
    </FsLex>
  </ItemGroup>
</Project>
